# ================================
# GUARD PAINEL - Configuração backend
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" com credenciais reais no git.
# ================================

# Banco de dados
# SQLite (padrão, zero configuração):
DATABASE_URL="file:./dev.db"
# Para Postgres em produção, troque o provider no schema.prisma para "postgresql" e use:
# DATABASE_URL="postgresql://usuario:senha@host:5432/guard_painel"

# Sessão / JWT
SESSION_SECRET="troque-por-uma-string-aleatoria-longa-e-secreta"
JWT_EXPIRES_IN="12h"

# Criptografia de credenciais armazenadas (AES-256-GCM). Deve ter 32 caracteres.
CREDENTIALS_ENCRYPTION_KEY="troque-por-32-caracteres-secretos"

# Usuários iniciais (usados apenas no "npm run seed", na primeira instalação)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"

SECONDARY_USER_NAME="Usuário"
SECONDARY_USER_EMAIL="usuario@example.com"
SECONDARY_USER_PASSWORD="troque-esta-senha"
SECONDARY_USER_ACTIVE="true"

# Compatibilidade opcional: Shopee. Prefira configurar Partner ID/Key na tela Integrações.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Ambiente: "live" ou "test" (sandbox)
SHOPEE_ENV="test"

# Compatibilidade opcional: Mercado Livre. Prefira configurar Client ID/Secret na tela Integrações.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# Site: MLB=Brasil, MLA=Argentina, MLM=México, MCO=Colômbia, MLC=Chile...
MERCADOLIVRE_SITE_ID="MLB"

# Compatibilidade opcional: TikTok Shop. Prefira configurar App Key/Secret na tela Integrações.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Ambiente: "live" ou "sandbox"
TIKTOK_ENV="sandbox"

# URL pública do backend (necessária para o callback de OAuth de qualquer marketplace)
BACKEND_PUBLIC_URL="https://seu-backend-publico.exemplo.com"
# Para onde o navegador volta após concluir o OAuth
FRONTEND_URL="http://localhost:5173"

PORT=4000
