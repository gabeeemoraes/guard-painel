# ================================
# GUARD PAINEL - Configuração backend
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA cometa o arquivo ".env" com credenciais reais no git.
# ================================

DATABASE_URL="file:./dev.db"
# Para Postgres em produção, use a URL do banco e o provider PostgreSQL no schema.prisma.

SESSION_SECRET="troque-por-uma-string-aleatoria-longa-e-secreta"
JWT_EXPIRES_IN="12h"
CREDENTIALS_ENCRYPTION_KEY="troque-por-32-caracteres-secretos"

ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-esta-senha"
SECONDARY_USER_NAME="Usuário"
SECONDARY_USER_EMAIL="usuario@example.com"
SECONDARY_USER_PASSWORD="troque-esta-senha"
SECONDARY_USER_ACTIVE="true"

# Shopee
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ENV="test"

# Mercado Livre
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_SITE_ID="MLB"

# TikTok Shop
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# Service ID da aplicação no TikTok Shop Partner Center.
# Se omitido, o backend usa TIKTOK_APP_KEY como fallback para compatibilidade.
TIKTOK_SERVICE_ID=
TIKTOK_ENV="sandbox"

# URL pública do backend (necessária para os callbacks OAuth)
BACKEND_PUBLIC_URL="https://seu-backend-publico.exemplo.com"
FRONTEND_URL="http://localhost:5173"
PORT=4000
