{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://guard-painel-api-moraes-corp.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "guard-painel.vercel.app"
        }
      ],
      "destination": "https://guard-painel-moraes-corp.vercel.app/:path*",
      "permanent": true
    }
  ]
}
